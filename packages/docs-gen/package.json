{
  "name": "@crewcircle/docs-gen",
  "version": "0.1.0",
  "description": "Generic OpenWiki-based documentation generation, shared across CrewCircle repos",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "crewcircle-docs": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "documentation",
    "openwiki",
    "crewcircle",
    "ci"
  ],
  "author": "CrewCircle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/crewcircle/crewcircle-website.git",
    "directory": "packages/docs-gen"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

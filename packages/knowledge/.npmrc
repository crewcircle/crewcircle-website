# npm registry configuration for @crewcircle/knowledge
# Used by CI/CD for publishing

# Set the registry for the @crewcircle scope
@crewcircle:registry=https://registry.npmjs.org/

# Enable provenance attestations (requires npm 9.5+)
provenance=true

# Always authenticate when publishing
always-auth=true

# Save exact versions to package-lock.json
save-exact=true

# Legacy peer deps (if needed for older packages)
legacy-peer-deps=false
{
  "name": "@crewcircle/knowledge",
  "version": "0.1.0",
  "description": "CrewCircle Knowledge Layer - Internal Org Memory & External App Context Layer",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.mjs",
      "require": "./dist/providers/index.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "import": "./dist/internal/index.mjs",
      "require": "./dist/internal/index.js"
    },
    "./external": {
      "types": "./dist/external/index.d.ts",
      "import": "./dist/external/index.mjs",
      "require": "./dist/external/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "import": "./dist/ai-sdk/index.mjs",
      "require": "./dist/ai-sdk/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js"
    }
  },
"scripts": {
    "build": "tsc -p tsconfig.json --outDir dist && tsc -p tsconfig.json --outDir dist/esm --module ESNext --moduleResolution bundler && tsc -p tsconfig.json --outDir dist/cjs --module CommonJS --moduleResolution node",
    "build:watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/admin/cli.ts"
  },
  "keywords": [
    "knowledge-graph",
    "rag",
    "ai-memory",
    "cognee",
    "crewcircle"
  ],
  "author": "CrewCircle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/crewcircle/crewcircle-website.git",
    "directory": "packages/knowledge"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "ai": "^3.4.0",
    "commander": "^12.0.0",
    "openai": "^4.28.0",
    "pg": "^8.11.3",
    "pgvector": "^0.1.8",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "msw": "^2.1.0",
    "testcontainers": "^10.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
